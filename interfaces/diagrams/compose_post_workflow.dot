  "t_b_text_service_ComposeText_0_c0_url_shorten_service_ComposeUrls" [shape=box, style="filled", fillcolor="#F2F9EC", color="#3C763D", penwidth=1.5, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD><B><FONT COLOR="#1B4D1B">url-shorten-service::ComposeUrls</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="7" COLOR="#64748B">span: compose_urls_client</FONT></TD></TR><TR><TD><FONT POINT-SIZE="7" COLOR="#854D0E">[async]</FONT></TD></TR></TABLE>>];
