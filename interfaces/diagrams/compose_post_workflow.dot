  "p_b_text_service_ComposeText_0_in" [shape=circle, style="filled", fillcolor="#F3F4F6", color="#4B5563", penwidth=1.2, label="", xlabel=<<FONT POINT-SIZE="7" COLOR="#4B5563">text-service::ComposeText (in)</FONT>>, width=0.22, height=0.22, fixedsize=true, fontsize=7];
