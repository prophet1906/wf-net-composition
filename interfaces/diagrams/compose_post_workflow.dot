  "p_post_compose_post_barrier" -> "t_p2_post_storage_service_StorePost_0";
  "t_p2_post_storage_service_StorePost_0" -> "p_p2_post_storage_service_StorePost_0_out";
  "p_p2_post_storage_service_StorePost_0_out" -> "t_p2_user_timeline_service_WriteUserTimeline_1";
  "t_p2_user_timeline_service_WriteUserTimeline_1" -> "p_p2_user_timeline_service_WriteUserTimeline_1_out";
