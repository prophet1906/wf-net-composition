digraph "register_user_with_id_workflow" {
  // Portrait Layout & Global Settings
  rankdir="TB";
  charset="UTF-8";
  compound=true;
  bgcolor="#FAFAFA";
  node [fontname="Helvetica,Arial,sans-serif", fontsize=9];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8, color="#333333", arrowsize=0.7];

  // Places (Petri Net Conventions: Single circle initial with token, double circle final sink)
  "p_source" [shape=circle, style="filled", fillcolor="#D0E1F9", color="#1E395B", penwidth=1.8, label="●", xlabel=<<FONT POINT-SIZE="8" COLOR="#1E395B">source</FONT>>, width=0.28, height=0.28, fixedsize=true, fontsize=10];
  "p_ingress_out" [shape=circle, style="filled", fillcolor="#EBF3FA", color="#2A6496", penwidth=1.2, label="", xlabel=<<FONT POINT-SIZE="7" COLOR="#2A6496">ingress_out</FONT>>, width=0.22, height=0.22, fixedsize=true, fontsize=7];
  "p_p1_social_graph_service_InsertUser_0_out" [shape=circle, style="filled", fillcolor="#EBF3FA", color="#2A6496", penwidth=1.2, label="", xlabel=<<FONT POINT-SIZE="7" COLOR="#2A6496">social-graph-service::InsertUser (out)</FONT>>, width=0.22, height=0.22, fixedsize=true, fontsize=7];
  "p_sink" [shape=doublecircle, style="filled", fillcolor="#FDE8E8", color="#9B1C1C", penwidth=1.8, label="", xlabel=<<FONT POINT-SIZE="8" COLOR="#9B1C1C">sink</FONT>>, width=0.28, height=0.28, fixedsize=true, fontsize=9];

  // Transitions (Clean styling, no decorative icons)
  "t_ingress" [shape=box, style="filled", fillcolor="#E0F2FE", color="#0284C7", penwidth=1.5, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD><B><FONT COLOR="#0369A1">Ingress: RegisterUserWithId</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#475569">user-service::RegisterUserWithId</FONT></TD></TR><TR><TD><FONT POINT-SIZE="7" COLOR="#64748B">span: register_client</FONT></TD></TR></TABLE>>];
  "t_p1_social_graph_service_InsertUser_0" [shape=box, style="filled", fillcolor="#F2F9EC", color="#3C763D", penwidth=1.5, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD><B><FONT COLOR="#1B4D1B">social-graph-service::InsertUser</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="7" COLOR="#64748B">span: insert_user_client</FONT></TD></TR><TR><TD><FONT POINT-SIZE="7" COLOR="#854D0E">[direct]</FONT></TD></TR></TABLE>>];
  "t_egress" [shape=box, style="filled", fillcolor="#DCFCE7", color="#16A34A", penwidth=1.5, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD><B><FONT COLOR="#15803D">Egress: RegisterUserWithId Return</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#475569">user-service::RegisterUserWithId</FONT></TD></TR></TABLE>>];

  // Arcs
  "p_source" -> "t_ingress";
  "t_ingress" -> "p_ingress_out";
  "p_ingress_out" -> "t_p1_social_graph_service_InsertUser_0";
  "t_p1_social_graph_service_InsertUser_0" -> "p_p1_social_graph_service_InsertUser_0_out";
  "p_p1_social_graph_service_InsertUser_0_out" -> "t_egress";
  "t_egress" -> "p_sink";
}