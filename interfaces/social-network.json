        {
          "name": "RegisterUserWithId",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "register_user_with_id_server",
          "client_span": "register_user_with_id_client"
        },
        {
          "name": "Login",
          "pattern": "IP-4",
          "return_type": "string",
          "server_span": "login_server",
          "client_span": "login_client"
        },
        {
          "name": "ComposeCreatorWithUserId",
          "pattern": "IP-4",
          "return_type": "Creator",
          "server_span": "compose_creator_with_user_id_server",
          "client_span": "compose_creator_with_user_id_client"
        },
        {
          "name": "ComposeCreatorWithUsername",
          "pattern": "IP-4",
          "return_type": "Creator",
          "server_span": "compose_creator_with_username_server",
          "client_span": "compose_creator_with_username_client"
        },
        {
          "name": "GetUserId",
          "pattern": "IP-4",
          "return_type": "i64",
          "server_span": "get_user_id_server",
          "client_span": "user_mmc_get_user_id_client"
        }
      ]
    },
    "compose-post-service": {
      "channels": [
        {
          "name": "ComposePost",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "compose_post_server",
          "client_span": "compose_post_client"
        }
      ]
    },
    "post-storage-service": {
      "channels": [
        {
          "name": "StorePost",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "store_post_server",
          "client_span": "store_post_client"
        },
        {
          "name": "ReadPost",
          "pattern": "IP-4",
          "return_type": "Post",
          "server_span": "post_storage_read_posts_server",
          "client_span": "read_post_client"
        },
        {
          "name": "ReadPosts",
          "pattern": "IP-4",
          "return_type": "list<Post>",
          "server_span": "post_storage_read_posts_server",
          "client_span": "read_posts_client"
        }
      ]
    },
    "home-timeline-service": {
      "channels": [
        {
          "name": "ReadHomeTimeline",
          "pattern": "IP-4",
          "return_type": "list<Post>",
          "server_span": "read_home_timeline_server",
          "client_span": "read_home_timeline_redis_find_client"
        },
        {
          "name": "WriteHomeTimeline",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "write_home_timeline_server",
          "client_span": "write_home_timeline_redis_update_client"
        }
      ]
    },
    "user-timeline-service": {
      "channels": [
        {
          "name": "WriteUserTimeline",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "write_user_timeline_server",
          "client_span": "write_user_timeline_redis_update_client"
        },
        {
          "name": "ReadUserTimeline",
          "pattern": "IP-4",
          "return_type": "list<Post>",
          "server_span": "read_user_timeline_server",
          "client_span": "read_user_timeline_redis_find_client",
          "nested_dispatches": [
            {
              "service": "post-storage-service",
              "channel": "ReadPosts",
              "client_span": "read_posts_client",
              "launch_type": "async",
              "server_span": "read_posts_server"
            }
          ]
        }
      ]
    },
    "social-graph-service": {
      "channels": [
        {
          "name": "GetFollowers",
          "pattern": "IP-4",
          "return_type": "list<i64>",
          "server_span": "get_followers_server",
          "client_span": "get_followers_client"
        },
        {
          "name": "GetFollowees",
          "pattern": "IP-4",
          "return_type": "list<i64>",
          "server_span": "get_followees_server",
          "client_span": "get_followees_client"
        },
        {
          "name": "Follow",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "unfollow_with_username_server",
          "client_span": "follow_client"
        },
        {
          "name": "Unfollow",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "unfollow_with_username_server",
          "client_span": "unfollow_client"
        },
        {
          "name": "FollowWithUsername",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "unfollow_with_username_server",
          "client_span": "follow_with_username_client",
          "nested_dispatches": [
            {
              "service": "user-service",
              "channel": "GetUserId",
              "client_span": "get_user_id_client",
              "launch_type": "async",
              "server_span": "get_user_id_server"
            },
            {
              "service": "user-service",
              "channel": "GetUserId",
              "client_span": "get_user_id_client",
              "launch_type": "async",
              "server_span": "get_user_id_server"
            }
          ]
        },
        {
          "name": "UnfollowWithUsername",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "unfollow_with_username_server",
          "client_span": "unfollow_with_username_client",
          "nested_dispatches": [
            {
              "service": "user-service",
              "channel": "GetUserId",
              "client_span": "get_user_id_client",
              "launch_type": "async",
              "server_span": "get_user_id_server"
            },
            {
              "service": "user-service",
              "channel": "GetUserId",
              "client_span": "get_user_id_client",
              "launch_type": "async",
              "server_span": "get_user_id_server"
            }
          ]
        },
        {
          "name": "InsertUser",
          "pattern": "IP-1",
          "return_type": "void",
          "server_span": "insert_user_server",
          "client_span": "insert_user_client"
        }
      ]
    },
    "user-mention-service": {
      "channels": [
        {
          "name": "ComposeUserMentions",
          "pattern": "IP-4",
          "return_type": "list<UserMention>",
          "server_span": "compose_user_mentions_server",
          "client_span": "compose_user_mentions_mongo_find_client"
        }
      ]
    },
    "url-shorten-service": {
      "channels": [
        {
          "name": "ComposeUrls",
          "pattern": "IP-4",
          "return_type": "list<Url>",
          "server_span": "compose_urls_server",
          "client_span": "compose_urls_client"
        },
        {
          "name": "GetExtendedUrls",
          "pattern": "IP-4",
          "return_type": "list<string>",
          "server_span": "get_extended_urls_server",
          "client_span": "get_extended_urls_client"
        }
      ]
    },
    "media-service": {
      "channels": [
        {
          "name": "ComposeMedia",
          "pattern": "IP-4",
          "return_type": "list<Media>",
          "server_span": "compose_media_server",
          "client_span": "compose_media_client"
        }
      ]
    }
  }
}